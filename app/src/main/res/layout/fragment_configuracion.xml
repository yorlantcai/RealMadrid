<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuración"
        android:textColor="@color/texto_claro"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="26dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar_ring"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                android:src="@color/card_fondo"
                app:civ_border_width="0dp"/>

            <TextView
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                android:text="RM"
                android:gravity="center"
                android:textColor="@color/dorado"
                android:textSize="34sp"
                android:textStyle="bold"/>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario conectado"
            android:textColor="@color/texto_gris"
            android:textSize="13sp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario"
            android:textColor="@color/texto_claro"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Cerrar sesión"
        android:textColor="@color/dorado"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/bg_boton_logout"
        android:layout_marginBottom="36dp"/>

</LinearLayout>
